<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             id="Definitions_dataFlows"
             targetNamespace="http://flowable.org/bpmn">
  <signal id="globalSignal" name="global" flowable:scope="global" />
  <signal id="localSignal" name="local" />
  <process id="process" isExecutable="true">
    <extensionElements>
      <flowable:localization locale="de" name="Prozess" />
    </extensionElements>
    <dataObject id="threshold" name="threshold" itemSubjectRef="xsd:int">
      <extensionElements>
        <flowable:value>10</flowable:value>
      </extensionElements>
    </dataObject>
    <dataObjectReference id="thresholdRef" dataObjectRef="threshold" />
    <dataObject id="customer" name="customer" itemSubjectRef="custom:Customer" />
    <dataObjectReference id="customerRef" dataObjectRef="customer" />
    <startEvent id="start" />
    <sequenceFlow id="toTask" sourceRef="start" targetRef="task" flowable:skipExpression="${skipTask}" />
    <userTask id="task" name="Review">
      <extensionElements>
        <flowable:localization locale="es" name="Revisar">
          <flowable:documentation>Revisar el pedido</flowable:documentation>
        </flowable:localization>
      </extensionElements>
    </userTask>
    <sequenceFlow id="toRaise" sourceRef="task" targetRef="raise" />
    <intermediateThrowEvent id="raise">
      <signalEventDefinition signalRef="globalSignal" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="raiseLocal">
      <signalEventDefinition signalRef="localSignal" />
    </intermediateThrowEvent>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="100" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_di" bpmnElement="task"><dc:Bounds x="180" y="78" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_di" bpmnElement="raise"><dc:Bounds x="330" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raiseLocal_di" bpmnElement="raiseLocal"><dc:Bounds x="400" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="thresholdRef_di" bpmnElement="thresholdRef"><dc:Bounds x="100" y="220" width="36" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="customerRef_di" bpmnElement="customerRef"><dc:Bounds x="180" y="220" width="36" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toTask_di" bpmnElement="toTask"><di:waypoint x="136" y="118" /><di:waypoint x="180" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toRaise_di" bpmnElement="toRaise"><di:waypoint x="280" y="118" /><di:waypoint x="330" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
