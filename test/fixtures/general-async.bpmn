<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             id="Definitions_generalAsync"
             targetNamespace="http://flowable.org/bpmn">
  <process id="process" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="flow1" sourceRef="start" targetRef="plainTask" />
    <serviceTask id="plainTask" name="Plain" flowable:class="org.example.Plain" />
    <sequenceFlow id="flow2" sourceRef="plainTask" targetRef="asyncTask" />
    <serviceTask id="asyncTask" name="Async" flowable:class="org.example.Async" flowable:async="true" flowable:exclusive="false">
      <extensionElements>
        <flowable:failedJobRetryTimeCycle>R5/PT7M</flowable:failedJobRetryTimeCycle>
        <flowable:jobCategory>reports</flowable:jobCategory>
        <flowable:element-name>Two
lines</flowable:element-name>
        <flowable:includeInHistory>false</flowable:includeInHistory>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow3" sourceRef="asyncTask" targetRef="gateway" />
    <exclusiveGateway id="gateway" />
    <sequenceFlow id="flow4" sourceRef="gateway" targetRef="end" />
    <endEvent id="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="100" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="plainTask_di" bpmnElement="plainTask"><dc:Bounds x="180" y="78" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="asyncTask_di" bpmnElement="asyncTask"><dc:Bounds x="330" y="78" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_di" bpmnElement="gateway" isMarkerVisible="true"><dc:Bounds x="480" y="93" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="580" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1"><di:waypoint x="136" y="118" /><di:waypoint x="180" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2"><di:waypoint x="280" y="118" /><di:waypoint x="330" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3"><di:waypoint x="430" y="118" /><di:waypoint x="480" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4"><di:waypoint x="530" y="118" /><di:waypoint x="580" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
